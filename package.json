{
  "name": "kadr-studio",
  "productName": "Kadr Studio",
  "version": "0.1.0",
  "description": "Prosty edytor wideo: timeline, tekst, filtry, eksport MP4 (Electron + FFmpeg)",
  "main": "src/main/main.js",
  "author": {
    "name": "Kadr",
    "email": "kadr@example.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test:graph": "node test/graph.test.js",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage --x64 --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "pl.kadr.studio",
    "productName": "Kadr Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*",
      "!test{,/**}",
      "!README.md",
      "!.github{,/**}"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "files": [
        "!node_modules/ffprobe-static/bin/darwin/**",
        "!node_modules/ffprobe-static/bin/linux/**",
        "!node_modules/ffprobe-static/bin/win32/ia32/**"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "executableName": "kadr-studio",
      "synopsis": "Prosty edytor wideo",
      "files": [
        "!node_modules/ffprobe-static/bin/darwin/**",
        "!node_modules/ffprobe-static/bin/win32/**",
        "!node_modules/ffprobe-static/bin/linux/ia32/**"
      ],
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "appImage": {
      "artifactName": "Kadr-Studio-${version}-x86_64.${ext}"
    }
  }
}
